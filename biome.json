{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!.next",
			"!out",
			"!build",
			"!node_modules",
			"!public",
			"!next-env.d.ts",
			"!pnpm-lock.yaml"
		]
	},
	"formatter": {
		"enabled": true,
		"indentWidth": 2,
		"indentStyle": "tab",
		"lineWidth": 100,
		"lineEnding": "lf",
		"formatWithErrors": true
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"jsxQuoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always",
			"bracketSpacing": true
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		},
		"formatter": {
			"enabled": true,
			"indentStyle": "tab"
		}
	},
	"json": {
		"formatter": {
			"enabled": true,
			"indentWidth": 2,
			"lineWidth": 100
		}
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended",
			"next": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"useExhaustiveDependencies": "warn",
				"useHookAtTopLevel": "error",
				"noChildrenProp": "error"
			},
			"suspicious": {
				"noExplicitAny": "warn",
				"noArrayIndexKey": "warn",
				"noConsole": {
					"level": "warn",
					"options": { "allow": ["warn", "error"] }
				}
			},
			"style": {
				"useConst": "error",
				"useImportType": "off",
				"useExportType": "error",
				"useTemplate": "error",
				"useNodejsImportProtocol": "error",
				"useSelfClosingElements": "error",
				"noNonNullAssertion": "warn",
				"useShorthandFunctionType": "error"
			},
			"complexity": {
				"noUselessFragments": "error",
				"noForEach": "off"
			},
			"security": {
				"noDangerouslySetInnerHtml": "off"
			},
			"a11y": {
				"recommended": true
			}
		}
	}
}
